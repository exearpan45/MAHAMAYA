# Server-side bootstrap secret used once to promote the first, already-registered
# account to SUPER_ADMIN. Set it in Cloudflare Pages > Settings > Variables and
# Secrets (as a secret), or in an ignored .dev.vars file for local Pages dev.
# Generate at least 32 random bytes. Never put the real value in Vite-prefixed
# variables, frontend source, wrangler.toml, or a committed file.
BOOTSTRAP_SECRET="REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"

# Optional only when the public site uses a different canonical origin.
# If omitted, API writes require the request's exact same origin.
# APP_ORIGIN="https://mahamaya.pages.dev"
